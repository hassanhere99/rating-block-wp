{
	"name": "rating-block-wp",
	"version": "0.1.0",
	"description": "A 1 to 5 star rating block for the current post.",
	"author": "Muhammad Hassan",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --experimental-modules --blocks-manifest",
		"start": "wp-scripts start --experimental-modules --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"test:js": "wp-scripts test-unit-js",
		"wp-env": "wp-env",
		"env:start": "wp-env start",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"test:php": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/rating-block-wp vendor/bin/phpunit"
	},
	"dependencies": {
		"@wordpress/interactivity": "8.2.0"
	},
	"devDependencies": {
		"@wordpress/block-editor": "20.1.0",
		"@wordpress/blocks": "17.2.0",
		"@wordpress/components": "45.0.0",
		"@wordpress/env": "12.2.0",
		"@wordpress/i18n": "7.2.0",
		"@wordpress/scripts": "37.2.0",
		"vite": "8.3.8",
		"vitest": "5.1.2"
	},
	"private": true
}
